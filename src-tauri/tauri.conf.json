{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "week-report",
  "version": "1.0.0",
  "identifier": "com.lu.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:34115",
    "beforeDevCommand": "pnpm build && node scripts/build-server.mjs",
    "beforeBuildCommand": "pnpm build && node scripts/build-server.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist",
      "../server/dist/index.mjs": "server/dist/index.mjs",
      "../profile": "profile",
      "../resources": "resources"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}

{
  "name": "week-report",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm docs:build && vite",
    "build": "pnpm docs:build && vite build",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --test \"tests/**/*.test.js\"",
    "extensions:build": "pnpm -r --filter \"./extensions/*\" build",
    "build:server": "node scripts/build-server.mjs",
    "profile:build": "pnpm extensions:build && node scripts/build-profile.mjs",
    "plugin": "node packages/cli/bin.js",
    "week-report": "node packages/cli/bin.js",
    "plugin:add": "node packages/cli/bin.js plugin add",
    "plugin:remove": "node packages/cli/bin.js plugin remove",
    "plugin:list": "node packages/cli/bin.js plugin list"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "@element-plus/icons-vue": "^2.3.2",
    "animejs": "^4.5.0",
    "codemirror": "^6.0.2",
    "cordis": "4.0.0-rc.12",
    "element-plus": "^2.14.7",
    "handlebars": "^4.7.10",
    "js-yaml": "^5.5.0",
    "vditor": "^3.11.1",
    "vue": "^3.5.44",
    "vue-codemirror": "^6.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "less": "^4.9.1",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "sass": "^1.107.1",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitepress": "^1.6.4"
  }
}

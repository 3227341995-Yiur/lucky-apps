# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# 内置插件包按 node_modules 结构随应用资源提交
!src-tauri/resources/node_modules/
!src-tauri/resources/node_modules/**
packages/extensions/*/lib/
.DS_Store
dist
apps/desktop/.tmp-extensions
.tmp-*
dist-ssr
coverage
*.local

/cypress/videos/
/cypress/screenshots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo

# VitePress 构建产物（输出到 apps/desktop/public/docs，Vite 构建时复制进 dist/docs）
apps/desktop/public/docs

# 核心包从 TS 编译出的发布入口
packages/core/*/index.js
packages/core/*/lib/*.js
packages/core/*/*.mjs
packages/core/*/lib/*.mjs

# plugin-api npm build output
packages/sdk/plugin-api/lib/

# bundle / client 包的 TS 编译入口
packages/bundle/*/lib/*.js
packages/bundle/*/lib/*.mjs
packages/client/*/index.js
packages/client/*/lib/*.js
packages/client/*/lib/*.mjs

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lucky Apps",
  "version": "2.0.10",
  "identifier": "com.lu.week-report",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://127.0.0.1:34115",
    "beforeDevCommand": "pnpm plugins:build && pnpm build && node scripts/build-server.mjs && node scripts/build-profile.mjs",
    "beforeBuildCommand": "pnpm plugins:build && pnpm build && node scripts/build-server.mjs && node scripts/build-profile.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../apps/desktop/dist": "dist",
      "../apps/server/dist/index.mjs": "server/dist/index.mjs",
      "../resources": "resources",
      "target/profile": "profile"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  }
}

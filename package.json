{
  "name": "week-report",
  "version": "2.0.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -C apps/desktop exec vite",
    "build": "pnpm -C apps/desktop exec vite build && pnpm docs:build",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "preview": "pnpm -C apps/desktop exec vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --test \"tests/**/*.test.js\"",
    "plugins:build": "pnpm -r --filter \"./plugins/*\" build",
    "build:server": "node scripts/build-server.mjs",
    "profile:build": "pnpm plugins:build && node scripts/build-profile.mjs",
    "plugin": "node packages/cli/bin.js",
    "week-report": "node packages/cli/bin.js",
    "plugin:add": "node packages/cli/bin.js plugin add",
    "plugin:remove": "node packages/cli/bin.js plugin remove",
    "plugin:list": "node packages/cli/bin.js plugin list"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "cordis": "4.0.0-rc.12",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}

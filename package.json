{
  "name": "lucky-apps",
  "version": "3.2.26",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm docs:build && pnpm -C apps/desktop exec vite",
    "build": "pnpm docs:build && pnpm -C apps/desktop exec vite build",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "preview": "pnpm -C apps/desktop exec vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "plugins:build": "pnpm -r --filter \"./packages/extensions/*\" build",
    "build:server": "node scripts/build-server.ts",
    "profile:build": "pnpm plugins:build && pnpm packages:build && node scripts/build-profile.ts",
    "version:sync": "node scripts/sync-version.ts",
    "plugin": "node packages/tooling/cli/bin.ts",
    "lucky-apps": "node packages/tooling/cli/bin.ts",
    "plugin:add": "node packages/tooling/cli/bin.ts plugin add",
    "plugin:remove": "node packages/tooling/cli/bin.ts plugin remove",
    "plugin:list": "node packages/tooling/cli/bin.ts plugin list",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "packages:build": "tsdown",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "cordis": "4.0.0-rc.12",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "2.10.1",
    "esbuild": "^0.28.2",
    "eslint-plugin-sonarjs": "^4.1.0",
    "lefthook": "^2.1.9",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
